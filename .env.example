# Copy this file to .env.local and fill in the real values:
#     cp .env.example .env.local
# .env.local is git-ignored, so your real secrets are never committed.
#
# Rules
# - Never commit real secrets. Only this example file goes into git.
# - Anything starting with NEXT_PUBLIC_ is bundled into the browser and is
#   visible to anyone who views source. Never put a secret behind that prefix.
# - MONGODB_URI and JWT_SECRET are server-only: they are read in server code
#   only and are never shipped to the browser.

# Public site URL, used for metadata (canonical links, share images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend base URL, with NO trailing slash (e.g. https://xxx.onrender.com).
# For deployed builds this is set in the Vercel project settings
# (Settings -> Environment Variables) and baked in at build time;
# .env.local is not uploaded to Vercel.
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Server-only: MongoDB Atlas connection string (future backend phase).
MONGODB_URI=mongodb+srv://...

# Server-only: secret used to sign login tokens (future backend phase).
JWT_SECRET=your-secret-here